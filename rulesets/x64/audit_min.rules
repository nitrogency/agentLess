# ---Minimal ruleset---
# This is the minimal ruleset following the base CIS Ubuntu Server benchmark audit recommendations.
# Bare minimum ruleset that only uses the CIS recommendations. You probably shouldn't use this unless you want minimal logs.

# First rule - delete all
-D

# Increase the buffers to survive stress events.
# Make this bigger for busy systems
-b 8192

# Set failure mode to syslog
-f 1

# Ignore current working directory records
-a always,exclude -F msgtype=CWD

# Sensitive file modifying
# Editing these files can change or break the behavior of system users and grant privileges
# System groups
-a always,exit -F arch=b64 -F path=/etc/group -F perm=wa -F auid!=unset -k identity_mod
# System users
-a always,exit -F arch=b64 -F path=/etc/passwd -F perm=wa -F auid!=unset -k identity_mod
# Password for each group
-a always,exit -F arch=b64 -F path=/etc/gshadow -F perm=wa -F auid!=unset -k identity_mod
# System user passwords
-a always,exit -F arch=b64 -F path=/etc/shadow -F perm=wa -F auid!=unset -k identity_mod
# Storage of old passwords
-a always,exit -F arch=b64 -F path=/etc/security/opasswd -F perm=wa -F auid!=unset -k identity_mod
# Name service switch configuration
-a always,exit -F arch=b64 -F path=/etc/nsswitch.conf -F perm=wa -F auid!=unset -k identity_mod
# PAM config files directory
-a always,exit -F arch=b64 -F dir=/etc/pam.d -F perm=wa -F auid!=unset -k identity_mod

# Permission modification
# Can be used to grant execution to scripts/binaries or read access to sensitive files
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S chown,lchown,fchown,fchownat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod

# Mounts by unprivileged users
# Mounting by user other than root is rare and unusual
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k mounts

# Sudoers modification
# Changes in sudoers files can alter regular or administrative user privileges, which may be abused
-a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=wa -F auid!=unset -k sudoers_mod
-a always,exit -F arch=b64 -F dir=/etc/sudoers.d -F perm=wa -F auid!=unset -k sudoers_mod

# Temporary privilege escalations (e.g. sudo)
# Commands executed with elevated privileges may be used maliciously
-a always,exit -F arch=b64 -C euid!=uid -S execve -F auid!=unset -k user_emulation

# Time-related events
# System date/time changes can be used to disrupt investigation and services which rely on accurate time
# Tune kernel clock
-a always,exit -F arch=b64 -S adjtimex,settimeofday -F auid!=unset -k time_change
# Set time using timeval and timezone
-a always,exit -F arch=b64 -S clock_settime -F auid!=unset -k time_change
# Sets internal clocks and timers
-a always,exit -F arch=b64 -F path=/etc/localtime -F perm=wa -F auid!=unset -k time_change

# Network environment changes - hostname, domain name, etc.
# Helps identify unauthorized host/domain name edits, network interface editing
-a always,exit -F arch=b64 -S sethostname,setdomainname -F auid!=unset -k system_env
-a always,exit -F arch=b64 -F path=/etc/issue -F perm=wa -F auid!=unset -k system_env
-a always,exit -F arch=b64 -F path=/etc/issue.net -F perm=wa -F auid!=unset -k system_env
# Hostnames and associated IP addresses
-a always,exit -F arch=b64 -F path=/etc/hosts -F perm=wa -F auid!=unset -k system_env
# Symbolic names for networks
-a always,exit -F arch=b64 -F path=/etc/networks -F perm=wa -F auid!=unset -k system_env
-a always,exit -F arch=b64 -F dir=/etc/network -F perm=wa -F auid!=unset -k system_env
# Network interface scripts and config files
-a always,exit -F arch=b64 -F dir=/etc/netplan -F perm=wa -F auid!=unset -k system_env

# Unsuccessful file access attempts
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k failed_access
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k failed_access

# Session initiation events
# Monitoring session creation time could inform about unusual login times
# All currently logged in users
-a always,exit -F arch=b64 -F path=/var/run/utmp -F perm=wa -F auid!=unset -k session
-a always,exit -F arch=b64 -F path=/var/log/tallylog -F perm=wa -F auid!=unset -k session
# Logins, logouts, shutdowns, reboots
-a always,exit -F arch=b64 -F path=/var/log/wtmp -F perm=wa -F auid!=unset -k session
-a always,exit -F arch=b64 -F path=/var/log/lastlog -F perm=wa -F auid!=unset -k session
# Failed login attempts
-a always,exit -F arch=b64 -F path=/var/log/btmp -F perm=wa -F auid!=unset -k session
-a always,exit -F arch=b64 -F path=/var/log/faillog -F perm=wa -F auid!=unset -k session

# File deletion
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k file_delete

# MAC policy changes
# Changes to AppArmor profiles can alter system behavior or grant additional privileges
-a always,exit -F arch=b64 -F dir=/etc/apparmor -F perm=wa -F auid!=unset -k MAC_policy
-a always,exit -F arch=b64 -F dir=/etc/apparmor.d -F perm=wa -F auid!=unset -k MAC_policy

# These commands can be used to alter ACLs or the security context
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/chcon -F auid>=1000 -F auid!=unset -k conf_chcon
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/setfacl -F auid>=1000 -F auid!=unset -k conf_setfacl
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/chacl -F auid>=1000 -F auid!=unset -k conf_chacl

# User account modification
# Usermod can be used to grant, edit or revoke privileges
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/sbin/usermod -F auid>=1000 -F auid!=unset -k usermod

# Kernel module loading
-a always,exit -F arch=b64 -S init_module,delete_module,finit_module -F auid>=1000 -F auid!=unset -k kernel_modules
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/bin/kmod -F auid>=1000 -F auid!=unset -k kernel_modules

# Firewall events
-a always,exit -F arch=b64 -S execve,execveat -F exe=/usr/sbin/ufw -F auid>=1000 -F auid!=unset -k firewall
-a always,exit -F arch=b64 -F dir=/etc/ufw/ -F perm=wa -F auid>=1000 -F auid!=unset -k firewall

# Systemd events - related to services, units, timers - sensitive,, method of persistance
-a always,exit -F arch=b64 -S execve,execveat -F exe=/bin/systemctl -F auid>=1000 -F auid!=unset -k systemd_monitoring
-a always,exit -F arch=b64 -F dir=/etc/systemd/   -F perm=wa -F auid>=1000 -F auid!=unset -k systemd_monitoring

# 32 bit ABI exploitation: https://github.com/linux-audit/audit-userspace/blob/c014eec64b3a16c004f4a75e5792a4ac2fcc0df2/rules/21-no32bit.rules
-a always,exit -F arch=b32 -S all -k 32bit_abi
